---
import Layout from "./Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Tag from "../components/Tag.astro";
// We will format the date manually to avoid the import error
import { parseNostrMarkdown } from "../utils/parseMarkdown";

export interface Props {
  post: any; 
}

const { post } = Astro.props;
const { 
  title, 
  author, 
  description, 
  ogImage, 
  pubDatetime, 
  tags, 
  naddr, 
  content 
} = post;

// Process Markdown + Math
const htmlContent = await parseNostrMarkdown(content);

// Simple Date Formatting (Fallback for the broken Datetime component)
const dateStr = new Date(pubDatetime).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={title} author={author} description={description} ogImage={ogImage}>
  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
    crossorigin="anonymous"
  />

  <Header />
  
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button class="focus-outline mb-2 mt-8 flex hover:opacity-75" onclick="history.back()">
      <svg xmlns="http://www.w3.org/2000/svg"><path d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"></path></svg>
      <span>Go back</span>
    </button>
  </div>

  <main id="main-content" class="mx-auto w-full max-w-3xl px-4 pb-12">
    <h1 class="text-3xl font-bold text-skin-accent">{title}</h1>
    
    <!-- Simple replacement for the Datetime component -->
    <div class="flex items-center space-x-2 opacity-80 my-2 text-sm">
      <svg xmlns="http://www.w3.org/2000/svg" class="scale-90 inline-block h-6 w-6 fill-skin-base" aria-hidden="true"><path d="M7 11h2v2H7zm0 4h2v2H7zm4-4h2v2h-2zm0 4h2v2h-2zm4-4h2v2h-2zm0 4h2v2h-2z"></path><path d="M5 22h14c1.103 0 2-.897 2-2V6c0-1.103-.897-2-2-2h-2V2h-2v2H9V2H7v2H5c-1.103 0-2 .897-2 2v14c0 1.103.897 2 2 2zM19 8l.001 12H5V8h14z"></path></svg>
      <span>{dateStr}</span>
    </div>
    
    {naddr && (
      <div class="mt-6 flex flex-wrap items-center gap-3 text-xs md:text-sm bg-skin-card/10 p-4 rounded-lg border border-skin-line/50">
        <span class="font-bold text-skin-base flex items-center gap-1">⚡ Nostr:</span>
        <a href={`nostr:${naddr}`} class="text-skin-accent hover:underline font-medium">Open in App</a>
        <span class="opacity-20">|</span>
        <a href={`https://yakihonne.com/article/${naddr}`} target="_blank" rel="noopener" class="hover:text-skin-accent opacity-80">Yakihonne</a>
        <span class="opacity-20">|</span>
        <a href={`https://primal.net/e/${naddr}`} target="_blank" rel="noopener" class="hover:text-skin-accent opacity-80">Primal</a>
      </div>
    )}

    <article id="article" role="article" class="prose prose-invert mt-8 max-w-none" set:html={htmlContent} />

    <ul class="my-8 flex flex-wrap gap-2">
      {tags && tags.map((tag: string) => <Tag tag={tag} />)}
    </ul>
  </main>

  <Footer />
</Layout>

<script>
  const renderMermaid = async () => {
    const codeBlocks = document.querySelectorAll("pre code.language-mermaid");
    if (codeBlocks.length === 0) return;
    try {
      const { default: mermaid } = await import("https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.esm.min.mjs");
      mermaid.initialize({ startOnLoad: false, theme: "dark" });
      for (const element of codeBlocks) {
        const rawCode = element.textContent || "";
        const id = `mermaid-${Math.random().toString(36).substr(2, 9)}`;
        const { svg } = await mermaid.render(id, rawCode);
        const container = element.parentElement;
        if (container) {
          const wrapper = document.createElement('div');
          wrapper.className = 'mermaid-container'; 
          wrapper.innerHTML = svg;
          container.replaceWith(wrapper);
        }
      }
    } catch (e) { console.error("Mermaid diagram failed:", e); }
  };
  renderMermaid();
  document.addEventListener("astro:after-swap", renderMermaid);
</script>