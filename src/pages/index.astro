---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
// Explicitly import the NDKEvent type
import NDK, { type NDKEvent } from "@nostr-dev-kit/ndk";
import 'ws'; 

const ndk = new NDK({ 
  explicitRelayUrls: [
    "wss://relay.damus.io", 
    "wss://nos.lol",
    "wss://relay.primal.net",
    "wss://relay.nostr.band"
  ] 
});

try {
  console.log("⏳ [Nostr] Connecting to relays...");
  await ndk.connect(3000); 
  console.log("✨ [Nostr] Connected successfully!");
} catch (err) {
  console.error("❌ [Nostr] Connection timed out or failed, proceeding anyway:", err);
}

const filter = { 
  kinds: [30023], 
  authors: ["444275c14d69c9e5b0caa6fd0863bb69042b10d9e31a84a377e255d2e00fd05c"]
};

// Strongly type the Set so TypeScript knows these are Nostr events
let events: Set<NDKEvent> = new Set();

try {
  console.log("⏳ [Nostr] Fetching events from relays...");
  
  // Use Promise.race to enforce a strict 4-second timeout that TypeScript understands
  const fetchPromise = ndk.fetchEvents(filter, { closeOnEose: true });
  const timeoutPromise = new Promise<Set<NDKEvent>>((resolve) => {
    setTimeout(() => resolve(new Set()), 4000);
  });
  
  events = await Promise.race([fetchPromise, timeoutPromise]);
  console.log(`✅ [Nostr] Successfully fetched ${events.size} events!`);
} catch (err) {
  console.error("❌ [Nostr] Fetching encountered an error:", err);
}

const posts = Array.from(events)
  // Tell TypeScript: If it passes this filter, it is an NDKEvent AND it has a valid created_at number
  .filter((e): e is NDKEvent & { created_at: number } => e.created_at !== undefined)
  .sort((a, b) => b.created_at - a.created_at)
  .map(e => {
    const rawContent = e.content;
    const cleanContent = rawContent
      .replace(/[#*`_~\[\]\(\)-]/g, "") 
      .replace(/\s+/g, " ")
      .trim();

    return {
      id: e.id,
      // Explicitly type 't' as an array of strings
      title: e.tags.find((t: string[]) => t[0] === 'title')?.[1] || "Untitled Mind-Log",
      summary: e.tags.find((t: string[]) => t[0] === 'summary')?.[1] || (cleanContent.substring(0, 120) + "..."),
      date: new Date(e.created_at * 1000).toLocaleDateString('zh-CN', {
        year: 'numeric', month: 'long', day: 'numeric'
      })
    };
  });
---

<Layout title="My Decentralized Mind-Dump">
  <Header />
  
  <main id="main-content" class="app-layout">
    
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        My Nostr Mind-Dump
      </h1>
      <p>
        These notes are pulled dynamically from the decentralized Nostr protocol at build time, 
        resulting in 100% static, SEO-perfect HTML. Write on Yakihonne, read everywhere.
      </p>
    </section>

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide mb-6">
        Recent Notes
      </h2>
      
      <ul>
        {posts.map(post => (
          <li class="my-6">
            <a href={`/nostr/${post.id}`} class="inline-block text-xl font-bold text-skin-accent decoration-dashed underline-offset-4 hover:underline">
              {post.title}
            </a>
            <div class="text-sm opacity-80 mt-1">{post.date}</div>
            <p class="mt-2 line-clamp-3">{post.summary}</p>
          </li>
        ))}
        {posts.length === 0 && <p>No articles found on the relays yet.</p>}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>