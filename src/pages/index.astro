---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import NDK from "@nostr-dev-kit/ndk";
import 'ws'; 

// 1. Initialize NDK with reliable relays
const ndk = new NDK({ 
  explicitRelayUrls: [
    "wss://relay.damus.io", 
    "wss://nos.lol",
    "wss://relay.primal.net",
    "wss://relay.nostr.band"
  ] 
});
await ndk.connect();

// 2. Fetch long-form blog posts (Kind 30023)
const filter = { 
  kinds: [30023], 
  authors: ["444275c14d69c9e5b0caa6fd0863bb69042b10d9e31a84a377e255d2e00fd05c"] // <-- PUT YOUR HEX KEY HERE
};

// 3. Process the data & Clean up SEO metadata
const events = await ndk.fetchEvents(filter);

const posts = Array.from(events)
  .filter((e): e is typeof e & { created_at: number } => e.created_at !== undefined)
  .sort((a, b) => b.created_at - a.created_at)
  .map(e => {
    const rawContent = e.content;
    
    // REGEX PATCH: Strip markdown symbols so Chinese/English summaries are perfectly clean for Web2 Spiders
    const cleanContent = rawContent
      .replace(/[#*`_~\[\]\(\)-]/g, "") 
      .replace(/\s+/g, " ")
      .trim();

    return {
      id: e.id,
      title: e.tags.find(t => t[0] === 'title')?.[1] || "Untitled Mind-Log",
      summary: e.tags.find(t => t[0] === 'summary')?.[1] || (cleanContent.substring(0, 120) + "..."),
      date: new Date(e.created_at * 1000).toLocaleDateString('zh-CN', {
        year: 'numeric', month: 'long', day: 'numeric'
      })
    };
  });
---

<Layout title="My Decentralized Mind-Dump">
  <Header />
  
  <main id="main-content" class="app-layout">
    
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        My Nostr Mind-Dump
      </h1>
      <p>
        These notes are pulled dynamically from the decentralized Nostr protocol at build time, 
        resulting in 100% static, SEO-perfect HTML. Write on Yakihonne, read everywhere.
      </p>
    </section>

    <section id="recent-posts" class="pt-12 pb-6">
      <h2 class="text-2xl font-semibold tracking-wide mb-6">
        Recent Notes
      </h2>
      
      <ul>
        {posts.map(post => (
          <li class="my-6">
            <a href={`/nostr/${post.id}`} class="inline-block text-xl font-bold text-skin-accent decoration-dashed underline-offset-4 hover:underline">
              {post.title}
            </a>
            <div class="text-sm opacity-80 mt-1">{post.date}</div>
            <p class="mt-2 line-clamp-3">{post.summary}</p>
          </li>
        ))}
        {posts.length === 0 && <p>No articles found on the relays yet.</p>}
      </ul>
    </section>
  </main>
  <Footer />
</Layout>